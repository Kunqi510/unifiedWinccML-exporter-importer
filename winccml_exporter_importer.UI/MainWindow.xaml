<tiaportal:TiaPortalWindow x:Class="Siemens.Application.TiaPortal.WinccmlExporterImporter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tiaportal="clr-namespace:Siemens.Collaboration.Net.TiaPortal;assembly=Siemens.Collaboration.Net.TiaPortal.Presentation"
        xmlns:converters="clr-namespace:Siemens.Application.TiaPortal.WinccmlExporterImporter.UI.Converters"
        xmlns:vm="clr-namespace:Siemens.Application.TiaPortal.WinccmlExporterImporter.UI.ViewModels"
        Title="TIA Portal WinCCML Importer and Exporter"
        Icon="icon.ico"
        Height="285"
        Width="520"
        MinHeight="260"
        MinWidth="420">
    <tiaportal:TiaPortalWindow.Resources>
        <converters:InvertBooleanConverter x:Key="InvertBoolConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </tiaportal:TiaPortalWindow.Resources>

    <tiaportal:TiaPortalWindow.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </tiaportal:TiaPortalWindow.DataContext>

    <DockPanel Margin="12">


        <!-- Mode (Export / Import) and description -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding InformationText}"
                       FontWeight="SemiBold"
                       TextAlignment="Left"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Margin="0,0,0,6" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,4,0,0">
                <RadioButton Content="Export" IsChecked="{Binding IsImport, Converter={StaticResource InvertBoolConverter}, Mode=TwoWay}" Margin="0,0,12,0" />
                <RadioButton Content="Import" IsChecked="{Binding IsImport, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,4,0,0">
                <RadioButton Content="Screen" IsChecked="{Binding IsTagTable, Converter={StaticResource InvertBoolConverter}, Mode=TwoWay}" Margin="0,0,12,0" />
                <RadioButton Content="Tag table" IsChecked="{Binding IsTagTable, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <!-- Project path -->
        <Grid DockPanel.Dock="Top" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Project path:" />
            <TextBox Grid.Column="1" Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" Margin="6,0" />
            <Button Grid.Column="2" Content="..." Width="30" Command="{Binding BrowseProjectCommand}" />
        </Grid>

        <!-- Screen / Tag table name (export always, import only for tag tables) -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding IsElementNameVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding ElementLabel}" />
            <TextBox Grid.Column="1" Text="{Binding ElementName, UpdateSourceTrigger=PropertyChanged}" Margin="6,0" />
        </Grid>


        <!-- Target path -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding TargetLabel}" />
            <TextBox Grid.Column="1" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Margin="6,0" />
            <Button Grid.Column="2" Content="..." Width="30" Command="{Binding BrowseTargetCommand}" />
        </Grid>

        <!-- Action button -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="{Binding ActionText}" Width="120" Command="{Binding ActionCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />
        </StackPanel>

        <!-- Results -->
        <TextBox Text="{Binding StatusText, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 FontSize="12" />
</DockPanel>
</tiaportal:TiaPortalWindow>
