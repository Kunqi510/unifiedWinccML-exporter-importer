<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3"/>
		<add key="siemens_nuget" value="https://captain.rtf.siemens.net/artifactory/api/nuget/v3/siemens-nuget"/>
		<add key="nuget_proxy" value="https://captain.rtf.siemens.net/artifactory/api/nuget/v3/nuget-remote"/>
	</packageSources>
	<packageRestore>
		<add key="automatic" value="True"/>
	</packageRestore>
</configuration>